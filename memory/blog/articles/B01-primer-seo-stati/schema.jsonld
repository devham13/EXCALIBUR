      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент",
          "text": "How-to, сравнение, чеклист - от типа зависит объем и формат."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Primary - в H1 (на странице WP) и lead; secondary - в подзаголовки естественно."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Нарисуйте outline",
          "text": "Каждый H2 = один подвопрос; первое предложение секции = тезис (island test)."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead",
          "text": "350-500 знаков: боль, суть ответа, что получит читатель."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Черновик по блокам",
          "text": "Абзацы 3-5 строк; списки для перечислений; таблица при сравнении."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Мета и медиа",
          "text": "Title около 55-65 знаков, Description до ~160; alt у картинок по содержанию, не по ключу."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "GEO-слой",
          "text": "FAQ 5-7 пар; атомарные блоки 60-100 слов под H2; schema - отдельным файлом."
        }
      ]
