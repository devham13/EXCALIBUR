        },
        {
          "@type": "HowToTool",
          "name": "Редактор или CMS блога"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Primary query, интент и 15-25 смежных фраз"
        },
        {
          "@type": "HowToSupply",
          "name": "Outline H2/H3 по результатам SERP"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте primary query, интент и 15-25 смежных фраз",
          "text": "Соберите их в Вордстат и подсказках; отрежьте запросы с чужим intent (коммерция vs how-to)."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Разберите топ-5-10 URL в SERP",
          "text": "Выпишите общие H2, таблицы, FAQ и пробелы, которые можете закрыть честнее конкурентов."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите outline",
          "text": "H1 + H2/H3; каждый H2 = подзадача плюс рекомендация \"делать / не делать\"."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead",
          "text": "Прямой ответ в первых 2-3 предложениях и обещание результата; ориентир 350-500 знаков в первом абзаце."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Наполните разделы",
          "text": "Списки, таблица, пример; ключи естественно в H1, lead и 1-2 H2, без переспама."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте FAQ 5-7 пар и мета",
          "text": "Вопросы как у людей; ответы 2-4 предложения - готовые чанки для AI."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Включите GEO-слой",
          "text": "Snippet-first в начале каждого H2, абзацы 3-7 строк, автор и даты актуализации."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Пройдите чеклист публикации",
          "text": "Мета, alt, перелинковка, Rich Results, читаемость на мобильном."
        }
      ]
    }
