      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Откройте топ-5 SERP",
          "text": "Запишите формат победителей и список подвопросов."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите ключи в Wordstat",
          "text": "Primary query, подсказки, \"вместе ищут\"."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Сгруппируйте в кластеры",
          "text": "3–5 групп; каждая – будущий H2 или FAQ."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Проверьте интент",
          "text": "Информационный, how-to, сравнение – от этого зависит объем."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Зафиксируйте secondary queries",
          "text": "\"seo текст для блога\", \"geo оптимизация статьи\" – в подзаголовки естественно."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Нарисуйте outline",
          "text": "4–6 H2 по подтемам; первое предложение секции – тезис."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Напишите lead",
          "text": "40–60 слов с прямым ответом на главный запрос в первых 30–50 словах."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Разложите черновик",
          "text": "Короткие абзацы, таблица при сравнении, инфостиль без \"воды\"."
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Встройте ключи",
          "text": "Primary в H1, lead, 1–2 H2; secondary – по тексту без переспама."
        }
      ]
