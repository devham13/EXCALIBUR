      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объем зависит от темы и SERP. Для how-to longread ориентир 8 500-9 500 знаков. Сравните топ-5 конкурентов и закройте те же подтемы без воды."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цитирование в AI-ответах при индексируемом контенте. Настройте атомарные H2, FAQ и schema - классическую семантику не отменяет."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Primary - в заголовках и lead, LSI - естественно. Плотность до 2-3% - ориентир естественности, не KPI."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - сниппет (50-60 символов, ключ и триггер). H1 - на странице. Не дублируйте дословно; проверьте превью до публикации."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BlogPosting + FAQPage в JSON-LD. Текст FAQ = видимый HTML. HowTo - бонус, если шаги явно выделены в body."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Файл-подсказка AI-краулерам; не замена sitemap. Имеет смысл после 5-10 материалов в блоге с нейропоиском."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите 15 пунктов чеклиста выше, затем QA: linter HTML, ссылки, slop, каннибализация ключей."
          }
        }
      ]
