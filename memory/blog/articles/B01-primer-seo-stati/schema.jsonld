      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Определите интент",
          "text": "Откройте SERP по primary query \"как писать seo статьи\", зафиксируйте тип страниц (how-to) и обязательные подтемы конкурентов.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Primary + secondary из карточки темы; кластеры в Яндекс Вордстат и Яндекс Вебмастер; сгруппируйте 3-5 смысловых блоков под H2.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Разберите ТОП-5",
          "text": "Выпишите повторяющиеся H2 и пробелы (читабельность, GEO, чеклист) - ваш дифференциатор.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Составьте каркас до текста",
          "text": "H1 - один на страницу; 4-6 H2; H3 для деталей; lead 40-70 слов с прямым ответом.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Напишите черновик для людей",
          "text": "Короткие абзацы 3-5 строк, списки, таблица \"ошибка → что делать\"; без переспама ключей.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте SEO-слой",
          "text": "Title около 60 знаков, Description 140-160, ключи в H1, первом абзаце и 1-2 H2 естественно; alt у изображений по содержанию.",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте GEO-слой",
          "text": "Snippet-first в начале каждого H2; FAQ 5-7; llms.txt - опционально, не миф \"обязателен для Google\".",
          "url": "https://mayai.ru/primer-seo-stati/#write-workflow"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Подготовьте schema",
          "text": "BlogPosting + FAQPage в JSON-LD; даты datePublished / dateModified актуальны; текст FAQ совпадает с HTML.",
          "url": "https://mayai.ru/primer-seo-stati/#schema-markup"
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Пройдите чеклист 15+ пунктов",
          "text": "Семантика, мета, структура, ссылки, island test, mobile перед publish.",
          "url": "https://mayai.ru/primer-seo-stati/#publish-checklist"
        }
      ]
