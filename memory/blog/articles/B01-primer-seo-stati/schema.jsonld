      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет – ориентируйтесь на SERP. Для how-to longread: 8 500–9 500 знаков. Сравните топ-5 конкурентов и закройте те же подвопросы без воды."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цитирование в AI-ответах при той же базе контента. Начните с answer-first блоков и FAQ, затем FAQPage schema."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет – переспам вреден. Primary query в lead и заголовках; LSI естественно. Прочитайте вслух и уберите лишнее."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title – сниппет (~60–65 знаков). H1 – на странице. Не дублируйте дословно; один интент, разные роли."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BlogPosting + FAQPage. Текст FAQ совпадает с HTML. Обновляйте dateModified при правках."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Чеклист: семантика, мета, H2, FAQ, schema, ссылки, island test. Затем linter HTML и проверка ссылок."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли писать SEO-статью только под роботов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Без удержания человека падают SEO- и GEO-сигналы. Пишите для читателя, упаковывая answer-first блоки и FAQ."
          }
        }
      ]
    }
