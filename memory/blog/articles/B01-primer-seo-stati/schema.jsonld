    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - Яндекс прямо указывает, что объём зависит от темы и конкуренции. Сравните топ выдачи по вашему запросу; для обучающего longread в этом блоге ориентир 8 500-9 500 знаков текста."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO - дополнение к классическому SEO: вы структурируете тот же индексируемый текст так, чтобы фрагменты цитировали в AI-ответах. База одна: нормальный человеческий материал плюс FAQ и schema."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли переспам ключей в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Достаточно естественных вхождений primary и тематических слов. Если абзац ради ключей - перепишите его под вопрос читателя."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета в выдаче (~55-60 символов), H1 - заголовок на странице. Смысл связан, но дословное копирование не нужно."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting или Article, при видимом FAQ - FAQPage. Текст в JSON-LD должен совпадать с HTML. Organization связывает материал с брендом."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли отдать текст нейросети без правок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Рискованно: галлюцинации фактов и \"вода\". Используйте ИИ для черновика и структуры, финал - человек; так же советуют human-in-the-loop данные из fact-bank."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чек-лист выше: семантика, intent, мета, FAQ, ссылки, island test и читабельность. После публикации отметьте дату обновления при правках."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://mayai.ru/primer-seo-stati/#howto",
      "name": "Как писать SEO-статьи, которые читают люди",
      "description": "Workflow SEO + GEO: семантика и SERP, структура longread с BLUF, черновик, мета, FAQ и чек-лист перед публикацией.",
      "inLanguage": "ru",
      "totalTime": "PT180M",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Яндекс Вордстат и Яндекс Вебмастер или ручной разбор SERP"
        },
        {
          "@type": "HowToTool",
          "name": "CMS или редактор с полями Title, Description и alt"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Список primary query и 5–10 LSI-формулировок"
        },
        {
          "@type": "HowToSupply",
          "name": "Тексты FAQ для HTML и JSON-LD"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте спрос",
          "text": "Запишите primary запрос и 5–10 смежных формулировок (LSI); сгруппируйте по intent (информационный, коммерческий)."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Разберите топ выдачи",
          "text": "Откройте топ 5–10 результатов: формат, глубина, таблицы, даты, пробелы (FAQ, цифры с источником)."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите каркас с BLUF",
          "text": "H1 = главный запрос; H2 по подвопросам; под каждым H2 — тезис в первом предложении и 3–5 буллетов содержания."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите черновик",
          "text": "Lead 350–500 символов с прямым ответом; абзацы 3–5 строк; списки и таблицы; E-E-A-T lite с источником."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Расставьте ключи",
          "text": "Primary в H1, lead и 1–2 H2; LSI по тексту естественно; без переспама."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Оформите мета и медиа",
          "text": "Title ~55–60 символов, description с пользой; alt у изображений; H1 и Title не дублируйте дословно."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте GEO-слой",
          "text": "FAQ 5–7 с ответами-действиями; каждый H2 как «остров смысла»; перелинковка на hub-материалы при необходимости."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Пройдите pre-publish чек-лист",
          "text": "Семантика, intent закрыт, FAQ совпадает с FAQPage, ссылки, орфография, mobile; план обновления dateModified."
        }
      ]
    }
