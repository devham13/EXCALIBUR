      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент",
          "text": "Зафиксируйте интент и список 1 основного + 5-20 смежных фраз."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Разберите ТОП-10",
          "text": "Разберите ТОП-10: объём, H2, FAQ, таблицы у конкурентов."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите outline",
          "text": "Соберите outline H1 + H2/H3 до написания текста."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead",
          "text": "Напишите lead как прямой ответ на primary query."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Разложите тело",
          "text": "Разложите тело: факты, списки, одна таблица при сравнении."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте GEO-слой",
          "text": "Добавьте GEO-слой: тезис в первом предложении каждого H2."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Сформируйте FAQ",
          "text": "Сформируйте FAQ 5-7 пар с короткими action-ответами."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Подготовьте мета",
          "text": "Подготовьте мета Title/Description и ЧПУ-slug."
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Мониторинг после публикации",
          "text": "После публикации добавьте URL в sitemap; через 2-4 недели смотрите показы в Вебмастере и GSC."
        }
      ]
