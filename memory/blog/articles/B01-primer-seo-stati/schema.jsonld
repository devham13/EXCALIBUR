        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Напишите lead",
          "text": "350-500 знаков: боль, суть, результат для читателя."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Черновик для людей",
          "text": "Абзацы 3-5 строк, списки, таблица при сравнении."
