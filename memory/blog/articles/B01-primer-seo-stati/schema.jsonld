    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/blog/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - зависит от темы и SERP. Ориентир how-to longread: 8 500-9 500 знаков. Сокращайте блоки без новых фактов."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цитирование в AI-ответах. База - индексируемый структурированный контент. Без SEO GEO не работает."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Оценивают смысл; переспам вреден. Primary - в заголовках и lead, LSI - естественно в тексте."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета (~65 знаков). H1 - на странице. Не дублируйте: разные роли, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BlogPosting (или Article) + FAQPage при FAQ в HTML. JSON-LD отдельно; текст совпадает с видимым контентом."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Файл подсказок для AI-краулеров. Дополнение к sitemap. Для блога с упором на нейропоиск - полезен."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Чеклист: семантика, мета, H2, FAQ, schema, ссылки, island test. Затем QA: linter, slop, каннибализация."
          }
        }
      ]
    },
