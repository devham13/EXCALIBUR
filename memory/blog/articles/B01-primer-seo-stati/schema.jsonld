    {
      "@type": "FAQPage",
      "@id": "https://example.com/blog/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет – объём зависит от темы и SERP. Ориентир how-to longread: 8 500–9 500 знаков. Сократите лишнее; расширьте, если запрос не закрыт."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цитирование в AI-ответах. База – индексируемый структурированный контент. Начните с BLUF и FAQ, затем schema и llms.txt."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Поисковики оценивают смысл; переспам вреден. Primary – в заголовках и lead, secondary – естественно в тексте."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title – для сниппета (около 65 знаков). H1 – на странице. Не дублируйте: разные роли, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting и FAQPage при блоке вопросов. JSON-LD отдельно; FAQ совпадает с HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Файл подсказок для AI-краулеров. Дополнение к sitemap, не замена индексации. Добавьте при нескольких экспертных материалах."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Чеклист выше: семантика, мета, H2, FAQ, schema, ссылки, island test. Затем QA: linter HTML, ссылки, уникальность."
          }
        }
      ]
