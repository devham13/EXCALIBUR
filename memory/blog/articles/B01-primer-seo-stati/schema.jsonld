    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объём зависит от сложности темы и конкурентов в выдаче. Ориентир для how-to longread: 8 500–9 500 знаков, если SERP требует глубины. Сократите, если ответ уже полный; не раздувайте без новых фактов."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO (Generative Engine Optimization) дополняет SEO: цель - цитирование в AI-ответах при индексируемом контенте. База та же - структура, честные факты, FAQ. GEO без индексации не работает."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Поисковики оценивают смысл; переспам вреден. Primary query - в заголовках и lead, LSI - естественно в подзаголовках и абзацах."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета в выдаче (60–70 знаков, ключ и триггер). H1 - заголовок на странице. Не дублируйте: разные роли, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting и FAQPage, если есть блок вопросов. JSON-LD в отдельном файле; текст FAQ совпадает с видимым HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Файл подсказок для AI-краулеров (стандарт с сентября 2024). Дополнение к sitemap, не замена индексации. Для блога с нейропоиском - разумный шаг."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист: семантика, мета, структура H2, FAQ, schema, ссылки, island test. Затем технический QA: linter HTML, проверка ссылок, slop и каннибализация ключей."
          }
        }
      ]
    }
