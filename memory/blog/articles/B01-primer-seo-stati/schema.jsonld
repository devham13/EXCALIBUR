    {
      "@type": "FAQPage",
      "@id": "${EXCALIBUR_PUBLIC_SITE_URL}/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет – объём зависит от сложности темы и конкурентов в выдаче. Ориентир для how-to longread: 8 500–9 500 знаков текста, если SERP требует глубины. Сократите, если абзац не добавляет нового действия или факта."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цель – цитирование в AI-ответах (Яндекс Нейро, Google AI Overviews). База та же – индексируемый, структурированный и честный контент. Начните с полного ответа человеку, затем добавьте FAQ и JSON-LD."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Поисковики оценивают смысл и полезность; переспам вреден. Используйте primary query в заголовках и lead, secondary и LSI – естественно в подзаголовках и абзацах."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title – для сниппета в выдаче (около 50–65 знаков, ключ и триггер). H1 – заголовок на странице. Их не дублируйте: разные роли, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting и FAQPage, если есть блок вопросов. JSON-LD в отдельном файле или meta; текст FAQ должен совпадать с видимым HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "llms.txt – файл подсказок для AI-краулеров. Полезный дополнительный сигнал рядом с sitemap, не замена индексации. Добавьте, когда на сайте пять и более экспертных материалов."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист: семантика, мета, структура H2, FAQ, schema, ссылки, читабельность, island test по блокам. Прочитайте lead вслух – если спотыкаетесь, перепишите первый абзац."
          }
        }
      ]
    }
  ]
