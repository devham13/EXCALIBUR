    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объем зависит от сложности темы и конкурентов в выдаче. Сверьте медиану ТОП-5 в Wordstat и выдаче. Для how-to longread ориентир 8 500-9 500 знаков, если SERP требует глубины."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO (Generative Engine Optimization) дополняет SEO: цель - цитирование в AI-ответах (Яндекс Нейро, Google AI Overviews). База та же - индексируемый, структурированный контент с атомарными H2 и FAQ."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Поисковики оценивают смысл; переспам вреден. Primary query - в H1, lead и 1-2 H2; secondary и LSI - естественно в подзаголовках."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета в выдаче (55-60 знаков, ключ и триггер). H1 - заголовок на странице. Не дублируйте дословно: Title продает клик, H1 раскрывает тему."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting (или Article) и FAQPage. JSON-LD в отдельном файле; текст FAQ должен совпадать с видимым HTML. HowTo - бонус для пошаговых инструкций."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист 16 пунктов выше: семантика, мета, H2, FAQ, schema, ссылки, island test. URL отправьте на переобход в Яндекс.Вебмастере и Google Search Console."
          }
        }
      ]
    },
