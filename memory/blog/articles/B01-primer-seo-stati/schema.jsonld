      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Определите интент",
          "text": "Откройте топ-5 SERP; зафиксируйте формат (гайд/чеклист) и обязательные блоки.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#intent-semantics"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Primary + 5-10 LSI; сгруппируйте в 3-5 кластеров под H2.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#intent-semantics"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Нарисуйте outline",
          "text": "H1 = главный запрос; каждый H2 = один подвопрос; первое предложение секции = тезис.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#structure-longread"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead",
          "text": "350-500 знаков; без вводных «в этой статье» и «вы узнаете».",
          "url": "https://mayai.ru/blog/primer-seo-stati/#structure-longread"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Разложите черновик",
          "text": "Абзацы 3-5 строк; списки для перечислений; таблица, если сравнение.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#structure-longread"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Впишите ключи",
          "text": "H1, первый абзац, 1-2 H2, Title/Description - естественно.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#structure-longread"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте FAQ и meta",
          "text": "5-7 реальных вопросов; Title ~60-70 знаков; Description ~150-160.",
          "url": "https://mayai.ru/blog/primer-seo-stati/#faq-schema"
        },
