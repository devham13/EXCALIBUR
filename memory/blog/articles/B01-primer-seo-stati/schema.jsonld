      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент",
          "text": "How-to, сравнение или чеклист - от этого зависит глубина и число H2.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Снимите топ-10 SERP",
          "text": "Выпишите обязательные подтемы и пробелы, которые конкуренты не закрыли.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите семантическую карту",
          "text": "Таблица \"запрос / интент / будущий H2 или FAQ\".",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Соберите каркас",
          "text": "4-6 H2; lead 350-500 знаков: боль, суть, что сделает читатель.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Напишите черновик",
          "text": "Абзацы 3-5 строк; после каждого H2 сразу содержательный ответ, без \"разогрева\".",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Доведите on-page SEO",
          "text": "Title, Description, alt у изображений, 2-4 внутренние ссылки с осмысленными анкорами.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте GEO-слой",
          "text": "5-7 FAQ; при необходимости упомяните llms.txt для AI-краулеров (не вместо sitemap).",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
