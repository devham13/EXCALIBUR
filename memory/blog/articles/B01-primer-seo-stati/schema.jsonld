    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/blog/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет (Яндекс Директ) – ориентир на полноту ответа и SERP. Для how-to longread Excalibur: 8 500–9 500 знаков. Сравните топ-5 и закройте пробелы."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цитирование в AI-ответах при индексируемой структуре. Пишите атомарные H2, факты со ссылками и FAQ – без отдельного \"текста для нейросети\"."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет – переспам вреден; в GEO keyword stuffing хуже baseline на ~10% (Princeton). Вставляйте ключи в lead, 1–2 H2, title/description."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title – сниппет (~50–60 символов), H1 – на странице. Не дублируйте: Title короче с крючком, H1 раскрывает обещание."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BlogPosting + FAQPage; HowTo – бонус для гайдов. Проверьте JSON-LD в Google Rich Results Test и валидаторе Яндекса."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли llms.txt блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Опционально: 97% llms.txt без запросов (Ahrefs, май 2026). Приоритет – HTML, Schema, sitemap. Не заменяйте ими SEO."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист выше: семантика, мета, FAQ, schema, island test. Публикуйте только после галочек на критичных пунктах."
          }
        }
      ]
    },
