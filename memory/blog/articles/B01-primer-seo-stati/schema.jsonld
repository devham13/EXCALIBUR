      "tool": [
        {
          "@type": "HowToTool",
          "name": "Яндекс Вордstat"
        },
        {
          "@type": "HowToTool",
          "name": "Редактор и CMS блога"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Список 15–25 ключевых и LSI-фраз по теме"
        },
        {
          "@type": "HowToSupply",
          "name": "Outline H2/H3 с тезисами-ответами"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент и один URL",
          "text": "Один главный запрос; запросы с другим intent (сравнение vs инструкция) – на отдельные страницы.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "15–25 фраз в Вордstat; primary – в H1 и lead, secondary – в H2 и абзацы естественно.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Разберите TOP-5–10 SERP",
          "text": "Какие H2 закрывают конкуренты, где пробел (например, читабельность).",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Соберите outline",
          "text": "H2 = подвопрос; первое предложение секции = тезис-ответ.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Напишите lead",
          "text": "350–500 знаков: боль, суть, что сделает читатель – без вводных клише из анти-словаря контракта.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Напишите черновик",
          "text": "Списки, таблица при сравнении; без переспама и штампов из редакционного контракта.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте FAQ 5–7",
          "text": "Короткие ответы-действия; текст в HTML потом должен совпасть с FAQPage в JSON-LD (готовит schema-агент).",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Оформите мета и медиа",
          "text": "Title ~65 знаков, Description ~155 с ключом и выгодой; alt у картинок описывает сцену, не \"seo картинка\".",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Добавьте GEO-слой",
          "text": "Определения 40–60 слов, атомарные H2; llms.txt – по желанию, не hype вместо контента.",
          "url": "https://mayai.ru/blog/primer-seo-stati/"
        }
      ]
    }
