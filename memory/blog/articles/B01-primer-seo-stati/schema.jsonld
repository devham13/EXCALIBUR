    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объём зависит от темы и медианы ТОП-10. Для how-to longread ориентир 8 500-9 500 знаков текста, если конкуренты дают глубокие чек-листы. Сокращайте, если блок не добавляет нового действия."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цель - цитирование в AI-ответах при той же индексируемой странице. База та же - полезный структурирный текст; добавляются атомарные чанки, FAQ и schema."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключи в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Естественные вхождения primary query и тематические LSI-слова. Плотность ключей не заменяет полноту ответа."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета (~55-65 знаков, ключ и триггер). H1 - на странице. Разные формулировки, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BlogPosting (или Article) и FAQPage, если есть блок вопросов. JSON-LD отдельно от body; текст FAQ совпадает с HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист: семантика, мета, H2-чанки, FAQ, schema, ссылки, lead, island test. После - технический QA: linter, ссылки, slop."
          }
        },
        {
          "@type": "Question",
          "name": "Когда ждать результат после публикации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Переобход в Вебмастере сразу после выкладки. Оценка позиций и поведения - через 2-4 недели; затем итерации по слабым блокам."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://mayai.ru/primer-seo-stati/#howto",
      "name": "Как писать SEO-статьи, которые читают люди",
      "description": "Пошаговый workflow SEO + GEO: от семантики и структуры longread до FAQ, schema и чеклиста перед публикацией.",
      "inLanguage": "ru",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент и результат",
          "text": "How-to, checklist или comparison - от этого зависит глубина и формат списков."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Primary в H1 и lead, 5-20 вторичных из Wordstat и блока \"Вместе с этим ищут\"."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Разберите ТОП-10",
          "text": "Медиана объёма, общие H2, пробел, который закроете вы."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Нарисуйте outline",
          "text": "Каждый H2 - подвопрос; под каждым - тезис, факт, ошибка, рекомендация."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Напишите lead и черновик",
          "text": "Абзацы 3-5 строк; citation-ready блоки по 60-100 слов в начале ключевых секций."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте FAQ и мета",
          "text": "5-7 пар в видимом HTML; Title до ~65 знаков, Description ~150-160."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Подключите schema",
          "text": "BlogPosting (или Article) + FAQPage в JSON-LD; текст FAQ совпадает с HTML."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Опубликуйте и контролируйте",
          "text": "Переобход в Вебмастере; оценка позиций и поведения через 2-4 недели, затем правки."
        }
      ]
    }
