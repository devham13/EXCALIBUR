    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объем зависит от сложности темы и конкурентов в выдаче. Ориентир для how-to longread: 8 500-9 500 знаков, если SERP требует глубины. Сравните топ-5 конкурентов и закройте запрос полнее, а не длиннее."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цель - цитирование в AI-ответах при индексируемом структурированном контенте. База та же - полезный текст с атомарными блоками, FAQ и schema. GEO без SEO не работает."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Поисковики оценивают смысл и полезность; переспам вреден. Используйте primary query в заголовках и lead, secondary и LSI - естественно в подзаголовках и абзацах."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета в выдаче (около 65 знаков, ключ и триггер). H1 - заголовок на странице. Их не дублируйте: разные роли, один интент."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting (или Article) и FAQPage, если есть блок вопросов. JSON-LD в отдельном файле; текст FAQ должен совпадать с видимым HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли писать SEO-статью с помощью ИИ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да как черновик. Обязательны личный опыт, факты с источниками и удаление ИИ-штампов. Финальную структуру и чек-лист проходит человек."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чек-лист: семантика, мета, структура H2, FAQ, schema, ссылки, читабельность, island test по блокам. После - технический QA: linter HTML, проверка ссылок, slop и каннибализация ключей."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://mayai.ru/primer-seo-stati/#howto",
      "name": "Как писать SEO-статьи, которые читают люди",
      "description": "Пошаговый workflow SEO + GEO: от интента и семантики Wordstat до FAQ, JSON-LD и чек-листа из 18 пунктов перед публикацией.",
      "inLanguage": "ru",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Яндекс Вордстат"
        },
        {
          "@type": "HowToTool",
          "name": "Яндекс Вебмастер"
        },
        {
          "@type": "HowToTool",
          "name": "Google Rich Results Test"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте задачу",
          "text": "Вбейте primary query в Яндекс или Google; определите тип страницы (гайд, сравнение, коммерция); запишите, что должен сделать читатель после прочтения."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Wordstat, подсказки, блок \"Похожие вопросы\"; сгруппируйте фразы в 3-5 кластеров; выберите главный ключ и 15-25 LSI/хвостов."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Разберите топ-5 SERP",
          "text": "H1/H2 конкурентов, таблицы, FAQ, дата, пробелы; выпишите, чем ваша статья будет полнее (опыт, чек-лист, GEO)."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Соберите структуру",
          "text": "H1 + 4-6 H2 из карточки темы; под каждым H2 - тезис-ответ; наметите FAQ 5-7 и таблицу или чек-лист."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Напишите черновик \"смысл первым\"",
          "text": "Короткие абзацы, lead с определением SEO-статьи в 40-60 слов, без переспама ключей."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Усильте E-E-A-T",
          "text": "E-E-A-T - следы в тексте: автор, дата, ссылки на первоисточники, кейс или цифра с URL; без выдуманных \"+140% трафика\"."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Техническая упаковка",
          "text": "Title/Description, перелинковка, alt, JSON-LD BlogPosting + FAQPage."
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Финальный прогон",
          "text": "Чек-лист ниже, island test, уберите воду и ИИ-штампы, согласуйте даты метаданных."
        }
      ]
    }
