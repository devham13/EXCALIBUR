          "url": "https://mayai.ru/primer-seo-stati/#eight-steps"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Добавьте GEO-слой",
          "text": "Чанки 40-80 слов, FAQ 5-7 пар, BlogPosting + FAQPage JSON-LD в schema.",
