    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - ориентируйтесь на полноту ответа и топ SERP. Для how-to longread в Excalibur BLOG - 8 500-9 500 знаков текста, если конкуренты дают глубину. Сокращайте воду, а не факты."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO дополняет SEO: цель - цитирование в AI-ответах при индексируемом структурированном контенте. База та же - честный полезный текст; GEO добавляет чанки, FAQ и schema."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключи в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Яндекс и эксперименты GEO-bench сходятся: смысл важнее плотности; переспам вреден. Вплетайте primary и LSI естественно в заголовки и абзацы."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета (~60-65 знаков, ключ и триггер). H1 - заголовок на странице. Не дублируйте строку в строку: одна тема, разные роли."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting (или Article) и FAQPage при видимом блоке вопросов. JSON-LD выносите в schema.jsonld; текст FAQ = HTML."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Опциональный сигнал для AI-краулеров рядом с sitemap. Полезен при росте блога и нейропоиска; не заменяет индексацию и robots.txt."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист из раздела выше, island test, затем технический QA: linter HTML, проверка ссылок, slop и utility gate. Исправьте блокеры до публикации."
          }
        }
      ]
    }
