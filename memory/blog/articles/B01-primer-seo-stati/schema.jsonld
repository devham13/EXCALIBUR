    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/blog/primer-seo-stati/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько символов должно быть в SEO-статье?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Универсальной нормы нет - объем зависит от сложности темы и конкурентов в выдаче, как указывает Яндекс. Для how-to longread в нашем формате целите 8 500-9 500 знаков текста, если SERP требует глубины. Сокращайте воду, а не факты."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое GEO в SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GEO - оптимизация под цитирование в AI-ответах при сохранении классического SEO-фундамента. Настраивайте структуру chunks, FAQ и schema; не заменяйте ими нормальный текст для людей."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли переспамить ключевые слова в 2026 году?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Вписывайте primary query в заголовки и lead, secondary и LSI - в контексте абзацев. Если фраза звучит неестественно вслух, перепишите предложение."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Title отличается от H1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Title - для сниппета в выдаче (около 65 знаков). H1 - заголовок на странице. Держите один интент, но разные формулировки; не копируйте строку один в один."
          }
        },
        {
          "@type": "Question",
          "name": "Какие schema нужны для SEO-статьи блога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Минимум BlogPosting и FAQPage при наличии блока вопросов. Передайте JSON-LD отдельным файлом; видимый HTML FAQ должен совпадать с разметкой."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое llms.txt и нужен ли он блогу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "llms.txt - подсказка для AI-краулеров, что индексировать. Добавьте файл на сайт, когда накопится несколько экспертных longread; это дополнение к sitemap, не замена."
          }
        },
        {
          "@type": "Question",
          "name": "Как проверить статью перед публикацией?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Пройдите чеклист из раздела выше: семантика, мета, H2-чанки, FAQ, schema handoff, ссылки, island test. Затем отдайте материал на GEO QA: linter HTML, проверка ссылок и фактов."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://mayai.ru/blog/primer-seo-stati/#howto",
      "name": "Как писать SEO-статьи, которые читают люди",
      "description": "Пошаговый workflow SEO + GEO: семантика, структура longread, FAQ, schema handoff и чеклист перед публикацией. Без переспама - для людей и нейропоиска.",
      "inLanguage": "ru",
      "totalTime": "PT120M",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Яндекс Вордстат (сбор семантики)"
        },
        {
          "@type": "HowToTool",
          "name": "Редактор или CMS блога"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Primary и secondary запросы из карточки темы или Вордстата"
        },
        {
          "@type": "HowToSupply",
          "name": "3-5 URL конкурентов из TOP SERP для outline"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Зафиксируйте интент",
          "text": "How-to, чеклист или сравнение - от этого зависит число шагов и нужна ли таблица."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите семантику",
          "text": "Primary - в H1 и lead; secondary (\"seo текст для блога\", \"geo оптимизация статьи\") - в подзаголовки и абзацы естественно."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Соберите outline",
          "text": "Каждый H2 закрывает один подвопрос; island test: вырежьте блок - смысл остается?"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead и TL;DR",
          "text": "Прямой ответ в первых 100-150 словах - зона, откуда AI часто берет цитату."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Разложите тело",
          "text": "Тезис в начале секции; рекомендация \"делать / не делать\" в каждом H2; без keyword stuffing."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте E-E-A-T",
          "text": "Автор, дата, ссылки на гайд Яндекса по SEO-тексту; без выдуманных процентов."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Подготовьте FAQ",
          "text": "Пять-семь пар с ответами-действиями на 2-4 предложения - те же формулировки потом уйдут в FAQPage schema."
        }
      ]
    }
