      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Проверьте спрос и интент",
          "text": "В Wordstat введите primary «как писать seo статьи» и secondary; выпишите 10–15 смежных вопросов; откройте топ-5 SERP и зафиксируйте пробелы конкурентов."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Соберите outline",
          "text": "H1 → lead 40–60 слов → H2 по кластеру → H3 для деталей; минимум одна таблица и два списка."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Определите интент",
          "text": "How-to, сравнение или справка – от этого зависят объём и структура seo текста для блога."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Напишите lead",
          "text": "350–500 знаков: боль, суть, результат – без клише «здесь вы узнаете»."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Разложите факты",
          "text": "Абзацы 3–5 строк; списки; таблица при сравнении."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Добавьте FAQ и мета",
          "text": "Пять–семь вопросов; Title и Description до публикации."
        }
      ]
