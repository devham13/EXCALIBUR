    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое human in the loop для AI-агентов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Checkpoint: агент предлагает action → Approve/Deny → tool выполняется или отменяется. Поставьте gate на connector в n8n до prod."
          }
        },
        {
          "@type": "Question",
          "name": "Как включить human review в n8n?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI Agent → \"+\" на tool → Add human review step → Slack/Telegram → $tool.name, $tool.parameters → system prompt про Deny."
          }
        },
        {
          "@type": "Question",
          "name": "Чем HITL в n8n отличается от Make?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "n8n: native gate на CE/Cloud. Make: native только Enterprise; иначе webhook split. См. таблицу в секции 4."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли HITL по EU AI Act?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-risk (Annex III): ст. 14 требует oversight. Остальное - best practice; при legal effects - GDPR Art. 22. Документируйте per agent."
          }
        },
        {
          "@type": "Question",
          "name": "Работают ли Cloud Agents Cursor без approve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. HITL = branch protection, PR review, CI, Automations quality bar. Run Modes - только local agent."
          }
        },
        {
          "@type": "Question",
          "name": "Что писать в system prompt про gated tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Список gated tools, поведение при Deny, запрет повторного подтверждения того, что уже за gate."
          }
        },
        {
          "@type": "Question",
          "name": "Когда снимать HITL?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "После N sandbox runs, низкого error rate, чистого audit. Payments/delete - только с compliance sign-off."
          }
        }
      ]
    },
