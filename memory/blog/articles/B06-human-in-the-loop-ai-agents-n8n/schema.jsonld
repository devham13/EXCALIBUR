      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Инвентаризация агентов",
          "text": "Составьте список workflows (n8n, Make, Cursor) и всех tool calls с side effects.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#why-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Карта рисков",
          "text": "Классифицируйте actions (finance, outbound, CRM write, delete, read-only, deploy) и отметьте обязательный HITL.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#risk-map"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "n8n: human review step",
          "text": "Откройте AI Agent workflow, на connector к risky tool нажмите \"+\" → Add human review step.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#n8n-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "n8n: канал и шаблон",
          "text": "Выберите Slack или Telegram; в message template используйте $tool.name и $tool.parameters.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#n8n-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "n8n: system prompt и tool description",
          "text": "Перечислите gated tools, сценарий Deny, описание в tool description (anti over-hedge).",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#n8n-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "n8n: sandbox Approve/Deny",
          "text": "Протестируйте Approve и Deny; проверьте, что агент корректно обрабатывает rejection.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#n8n-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Make: выбор пути HITL",
          "text": "Если Enterprise — Create review request; иначе split scenario + webhook approve/reject links.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#make-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Make: Router и Reasoning Panel",
          "text": "Настройте Router на approved/rejected path; ограничьте итерации Reasoning Panel.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#make-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Cursor: branch protection и CI",
          "text": "Включите branch protection, required reviewers, CI checks на PR от cursor bot.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#cursor-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 10,
          "name": "Cursor: Automations quality bar",
          "text": "Webhook/Slack trigger; в prompt — quality bar «open PR only if…»; Send to Slack для эскалации.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#cursor-hitl"
        },
        {
          "@type": "HowToStep",
          "position": 11,
          "name": "Audit trail",
          "text": "Логируйте execution id, tool params, reviewer, decision, timestamp (n8n execution log + external store).",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#checklist-25"
        },
        {
          "@type": "HowToStep",
          "position": 12,
          "name": "EU AI Act checklist",
          "text": "Задокументируйте in-the-loop vs on-the-loop per agent; опишите kill switch procedure.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#checklist-25"
        },
        {
          "@type": "HowToStep",
          "position": 13,
          "name": "Graduation policy",
          "text": "Зафиксируйте критерии снятия gate (N runs, error rate, compliance sign-off).",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#checklist-25"
        },
        {
          "@type": "HowToStep",
          "position": 14,
          "name": "Финальный прогон чек-листа",
          "text": "Пройдите 27 пунктов из секции 6 — все PASS перед prod.",
          "url": "https://mayai.ru/human-in-the-loop-ai-agents-n8n/#checklist-25"
        }
      ]
