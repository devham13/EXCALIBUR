    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/integraciya-amocrm-n8n-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как подключить amoCRM к n8n без программиста?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Создайте внешнюю интеграцию в amoМаркет, заведите credential в n8n, совместите Redirect URL, нажмите Connect my account. На self-host установите n8n-nodes-amocrm; на n8n Cloud используйте HTTP Request с OAuth2, если пакет не verified."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли программист для Telegram и webhook?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет для типового сценария: нужен админ amoCRM с правами интеграций и человек, который поднимет n8n с HTTPS для Telegram и внешних webhook."
          }
        },
        {
          "@type": "Question",
          "name": "Почему n8n не создает лид в amoCRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте Executions: проверьте OAuth (401), pipeline_id и status_id, тело POST /leads/complex и код 422. Часто ошибка в custom field или неверный subdomain."
          }
        },
        {
          "@type": "Question",
          "name": "Test URL или Production URL для amoCRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "amoCRM и формы сайта должны слать на Production URL. Test URL работает только пока вы слушаете webhook в редакторе n8n."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать при ошибке 429 от amoCRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Добавьте Wait и Retry, снизьте частоту ниже 7 rps на интеграцию, дробите пакеты до 50 сущностей и не запускайте петли webhook."
          }
        },
        {
          "@type": "Question",
          "name": "Как не плодить дубли контактов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Перед complex ищите контакт по телефону или email; при совпадении обновляйте или привязывайте lead. Включите idempotency по id события webhook."
          }
        },
        {
          "@type": "Question",
          "name": "Работает ли community amoCRM node в n8n Cloud?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Облако n8n ставит только verified community nodes. Если n8n-nodes-amocrm недоступен - соберите сценарий на HTTP Request и OAuth2 credential или перенесите n8n на self-host."
          }
        }
      ]
    },
