      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Create scenario",
          "text": "В Make нажмите Create a new scenario. На Free – до 2 active scenarios и минимум 15 минут между scheduled runs; учитывайте это для prod.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#create-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Добавьте trigger",
          "text": "Webhooks – Custom webhook для формы сайта; Slack – New event; Gmail – Watch emails. Сохраните тестовый bundle для Run once.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#create-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Вставьте Run an agent",
          "text": "Добавьте Make AI Agent (New) > Run an agent сразу после триггера или после фильтра, который отсекает спам.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#create-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Выберите Connection",
          "text": "Выберите Make's AI Provider (доступен на всех тарифах) или custom provider (OpenAI, Claude, Gemini – только paid; tokens платите провайдеру).",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#create-scenario"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Настройте Instructions и Input",
          "text": "Напишите Instructions: роль, цель, шаги, guardrails, формат JSON/text output. В блоке Input сопоставьте поля из trigger; для диалога включите Conversation ID и Maximum conversation history.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#instructions-limits"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Подключите tools",
          "text": "Добавьте 2-3 tools: module tool (Slack, Sheets), Call a scenario с Return outputs и On-demand, при необходимости Add MCP с минимальным набором tools.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#connect-tools"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Add knowledge",
          "text": "В Run an agent добавьте knowledge – upload регламента или brand guide в RAG vector database.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#knowledge-test"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Протестируйте в Chat и Run once",
          "text": "Откройте Chat на canvas – задайте 3-5 типовых заявок. Затем Run once с сохранённым bundle из trigger и проверьте Output.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#knowledge-test"
        },
        {
          "@type": "HowToStep",
          "position": 9,
          "name": "Отладка в Reasoning и prod checklist",
          "text": "В History откройте вкладку Reasoning; отключайте tools по одному для изоляции ошибок. Перед prod пройдите чеклист: filter, approval, лимит tools, мониторинг credits.",
          "url": "https://mayai.ru/nastrojka-make-ai-agents/#prod-checklist"
        }
      ]
    }
