    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/nastroyka-cursor-automations-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как настроить cursor automations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откройте cursor.com/automations/new → выберите trigger → напишите instructions → включите нужные tools → задайте repo scope → Save, Activate и Test run. Результат смотрите в Run History."
          }
        },
        {
          "@type": "Question",
          "name": "Чем cloud agents отличаются от automations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cloud Agent вы запускаете вручную. Automation – тот же cloud agent, но старт по trigger (cron, GitHub, Slack, webhook). Runs и billing одинаковые по API pricing."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли GitHub для брифа по расписанию?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Для cron и Slack без правок кода выберите No repository. GitHub обязателен только для source control triggers (PR opened, push)."
          }
        },
        {
          "@type": "Question",
          "name": "Как работает /goal в Cursor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Long-lived objective в новом чате cloud agent: агент держит цель до завершения (например, CI green). Pair с Custom Mode или /loop; subscriptions мониторят PR и Slack между runs."
          }
        },
        {
          "@type": "Question",
          "name": "Почему automation сработала не в 9:00 по Москве?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cron в Automations считается в UTC. Для 9:00 MSK летом используйте 0 6 * * * или preset и сверьте timestamp первого run в Run History."
          }
        },
        {
          "@type": "Question",
          "name": "Где хранить API-ключи для Automation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dashboard → Cloud Agents → Secrets. Тип Runtime Secret скрывает значение в transcript. Не храните ключи в environment.json, промпте или git."
          }
        },
        {
          "@type": "Question",
          "name": "Когда webhook URL пустой?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "URL и API key появляются только после Save и Activate Automation. Сохраните черновик, скопируйте endpoint, затем подключайте внешнюю систему."
          }
        }
      ]
    }
  ]
}
