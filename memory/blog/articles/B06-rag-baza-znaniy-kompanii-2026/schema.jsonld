    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/rag-baza-znaniy-kompanii-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько документов нужно для первого RAG?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "50–200 актуальных файлов на один сценарий – не вся компания. Лучше узкий FAQ поддержки, чем 10 000 страниц без owner."
          }
        },
        {
          "@type": "Question",
          "name": "Чем hybrid search лучше vector-only?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BM25 ловит артикулы и номера договоров; vector – синонимы и перефраз. RRF объединяет оба списка без сравнения \"несопоставимых\" score. На корпоративных формулировках прирост порядка 5–10% к точности (May AI, июнь 2026)."
          }
        },
        {
          "@type": "Question",
          "name": "Как обновлять базу без потери качества?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Re-index по webhook или cron при изменении файла; храните hash и версию индекса; после каждого re-index прогоняйте golden dataset – если faithfulness упал, откатите chunk или top-k."
          }
        },
        {
          "@type": "Question",
          "name": "Какой размер чанка для русского регламента?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Старт 256–512 или 500–700 токенов с overlap 10–20%. Проверьте на своих 20–30 вопросах – универсальной цифры нет."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли reranker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если baseline промахивается по точным формулировкам. Схема top-20 → rerank → top-3–5 в LLM; прирост качества retrieval 10–25% по Novacom."
          }
        },
        {
          "@type": "Question",
          "name": "Как не допустить утечки закрытых документов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ACL-фильтр в query vector DB до генерации – права проверяются до поиска и до передачи текста в LLM, не только в system prompt."
          }
        },
        {
          "@type": "Question",
          "name": "RAG или fine-tuning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RAG – для меняющихся регламентов и FAQ: обновили PDF – re-index. Fine-tuning – для стиля ответа или формата, когда факты стабильны."
          }
        }
      ]
    },
